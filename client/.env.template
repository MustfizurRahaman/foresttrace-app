REACT_APP_GOOGLE_MAPS_API_KEY=

# Tile / data CDN base URLs (no trailing slash).
# Leave empty to use local public/ folder during development.
REACT_APP_TILES_BASE_URL=
REACT_APP_DATA_BASE_URL=

# Copernicus Data Space (CDSE) – Sentinel-2 basemap for 2015–2017.
# Register free at https://dataspace.copernicus.eu → Dashboard → Configurations.
# REACT_APP_CDSE_LAYER must match the exact layer ID shown in your OGC config.
REACT_APP_CDSE_INSTANCE_ID=
REACT_APP_CDSE_LAYER=TRUE_COLOR
REACT_APP_USE_MAPLIBRE=true
REACT_APP_USE_COG_CLEARCUT=true