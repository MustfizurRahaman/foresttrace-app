REACT_APP_GOOGLE_MAPS_API_KEY=

# Optional local tile directories, read by src/setupProxy.js during development.
# Unset means the layer is proxied to Cloudflare R2 — what production serves.
# Set one to a pyramid OUTSIDE the repo to iterate on it before uploading;
# tiles under client/public/ make the CRA dev server crawl at startup.
# WILDFIRE_TILES_DIR=
# CARIBOU_TILES_DIR=
# WILDFIRE_BASELINE_TILES_DIR=

# Per-range caribou pyramids (range_<range>_<year>). Both are needed together:
# the dir serves them, the REACT_APP_ flag makes the app request them. Without
# both, range mode falls back to the per-FMU tiles.
# CARIBOU_RANGE_TILES_DIR=
# REACT_APP_CARIBOU_RANGE_TILES=true

# The following are server-side only — set them in the root .env, never here:
# PORT=3000
# NODE_ENV=development
# MONGODB_URI=mongodb://localhost:27017/your_database_name
# GROQ_API_KEY=gsk_...   # powers the ForestryAI /api/chat proxy